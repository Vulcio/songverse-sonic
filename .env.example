# Songverse Sonic's settings (every DEMUX_* variable is in API.md). Required:
DEMUX_API_KEY=change-me-to-a-long-random-key
# The models downloaded into the volume on start (otherwise on first use):
DEMUX_PRELOAD_MODELS=htdemucs htdemucs_ft
DEMUX_DEFAULT_MODEL=htdemucs
DEMUX_HQ_DEFAULT_MODEL=htdemucs_ft
DEMUX_CPU_JOBS=4
DEMUX_TIMEZONE=Europe/Paris
DEMUX_HQ_START_HOUR=2
DEMUX_HQ_END_HOUR=7
# Behind a reverse proxy (recommended, for HTTPS): its public address, and trust its headers.
DEMUX_PUBLIC_BASE_URL=
DEMUX_TRUST_PROXY_HEADERS=false
DEMUX_FORWARDED_ALLOW_IPS=127.0.0.1
ANALYSIS_ENABLED=true
# Chords (API 1.7): off, btc or btc-chordmini; the model is downloaded on first use.
ANALYSIS_CHORDS=off
ANALYSIS_CHORDS_INPUT=mix
# The analysis runs in its own process, stopped past this (default 3x ANALYSIS_TIMEOUT_SECONDS, min 120).
# ANALYSIS_HARD_LIMIT_SECONDS=180
